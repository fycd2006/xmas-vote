{
  "name": "xmas-vote",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm run build:web",
    "build:web": "npm --prefix web run build",
    "build:check": "npm run build:web",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && npm --prefix web run typecheck",
    "lint": "eslint \"worker/**/*.ts\" \"web/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"worker/**/*.ts\" \"web/src/**/*.{ts,tsx}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build:check",
    "db:migrate:local": "wrangler d1 migrations apply xmas-vote --local",
    "db:migrate:remote": "wrangler d1 migrations apply xmas-vote --remote",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "hono": "^4.6.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.34",
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^22.8.1",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "wrangler": "^3.100.0"
  }
}
